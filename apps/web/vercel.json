{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "VITE_API_URL=/backend pnpm --filter @ve/web build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/backend/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/((?!api/|backend/|assets/).*)", "destination": "/index.html" }
  ]
}
